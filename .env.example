SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=autoledger
POSTGRES_USER=autoledger
POSTGRES_PASSWORD=replace-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Use SQLite for local Python development; Docker always uses PostgreSQL.
USE_SQLITE=true
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Railway variables belong in the web service dashboard; see RAILWAY.md.
# DJANGO_SETTINGS_MODULE=config.production
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# MEDIA_ROOT=/data/media
